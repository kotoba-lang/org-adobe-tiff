{:paths ["src" "resources"]
 ;; org-ietf-deflate: TIFF Adobe Deflate (Compression 8/32946) strips are
 ;; zlib-wrapped, same codec PNG/ZIP/WOFF/PDF share (2026-07-08 wiring).
 :deps {io.github.kotoba-lang/org-ietf-deflate {:git/sha "430d754313e9082114ec00554e0b6770d9d318c5"}}
 :aliases {:test {:extra-paths ["test"]
                  :extra-deps {io.github.cognitect-labs/test-runner
                               {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                               ;; TEST-ONLY. Parity compiles
                               ;; kotoba/tiff/header.kotoba and runs it
                               ;; against tiff.core. Nothing in :paths
                               ;; depends on either. Pins are the west pair
                               ;; (amu + kotoba-kir) as of this commit.
                               io.github.kotoba-lang/amu
                               {:git/url "https://github.com/kotoba-lang/amu.git"
                                :git/sha "35e8a18f2842762bedbf88b32f22e1128ad95cf0"}
                               io.github.kotoba-lang/kotoba-kir
                               {:git/url "https://github.com/kotoba-lang/kotoba-kir.git"
                                :git/sha "099c627609ad506babf05f2d5e9a73b95c1b026b"}}
                  :main-opts ["-m" "cognitect.test-runner"]}
  ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
